    {
      "id": 15,
      "type": "timeseries",
      "title": "Load generator CPU / memory (is JMeter the bottleneck?)",
      "description": "Above ~80% CPU the load generator itself is limiting the test - add generators.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 44,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\", role=\"load-generator\"}[1m])))",
          "legendFormat": "CPU %",
          "refId": "A",
          "range": true,
